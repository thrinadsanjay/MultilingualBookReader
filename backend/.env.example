DEBUG=true
APP_NAME=Svara API
SECRET_KEY=change-me-in-production

# Password the server with a shared key instead of user accounts. When set, callers must send it
# as the X-API-Key header, which is what the phone does once you enter it in Settings.
# Generate one with: openssl rand -base64 32
API_KEY=
DATABASE_URL=sqlite+aiosqlite:///./bookreader.db
AUDIO_CACHE_DIR=./storage/audio
VOICE_SAMPLE_DIR=./storage/voice
CORS_ORIGINS=http://localhost:8080,http://10.0.2.2:8080

# Provider selection: tesseract | google_vision
OCR_PROVIDER=tesseract
# Provider selection: espeak | google | azure | elevenlabs
TTS_PROVIDER=espeak
# Provider selection: mock | elevenlabs
VOICE_PROVIDER=mock

# Optional cloud credentials — never commit real values
OCR_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
TTS_API_KEY=
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=
VOICE_API_KEY=

RATE_LIMIT=30/minute
ACCESS_TOKEN_EXPIRE_MINUTES=1440
