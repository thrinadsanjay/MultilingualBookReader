<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 and newer always show a launch screen. Without these the system falls back to the
      window background, so point it at the Svara mark on the brand navy.
    -->
    <style name="Theme.BookReader" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/launcher_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
