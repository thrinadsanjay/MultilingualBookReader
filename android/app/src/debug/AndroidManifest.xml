<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideloading test builds is a debug-only affordance. Keeping these out of the release manifest
  means the published app never asks Play for the sensitive install permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_UNKNOWN_APP_SOURCES" />
        </intent>
    </queries>
</manifest>
